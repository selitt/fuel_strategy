# Docker Compose loads this after copying to .env. No secrets required.
FUEL_PORT=8000
FUEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FUEL_MAX_REQUEST_BYTES=8388608
FUEL_MAX_UPLOAD_BYTES=2097152
# Local Python launch defaults to .local/projects; optionally export FUEL_DATA_DIR.
# .env is not auto-loaded by the Python application; use shell environment variables.

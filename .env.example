# Local by default. Public access requires HTTPS + an access gate.
FUEL_BIND_HOST=127.0.0.1
FUEL_WEB_PORT=8080
# Default: rebuild React/TypeScript with npm. Alternative uses supplied bundle:
# FUEL_DOCKERFILE=docker/Dockerfile.web-prebuilt
FUEL_HTTP_USER=
FUEL_HTTP_PASSWORD=
FUEL_MAX_UPLOAD_BYTES=2097152
FUEL_MAX_REQUEST_BYTES=8388608
